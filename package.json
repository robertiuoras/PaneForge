{
  "name": "claude-orchestrator",
  "version": "0.3.36",
  "private": true,
  "description": "PaneForge",
  "author": "Robert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertiuoras/PaneForge.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "node scripts/smoke-pty.mjs",
    "test:updater": "node scripts/updater-test.mjs",
    "test:gamemode": "node scripts/gamemode-test.mjs",
    "test:busy": "node scripts/busy-test.mjs",
    "test:focus": "node scripts/focus-test.mjs",
    "test:lanes": "node scripts/lane-test.mjs && node scripts/lane-memory-test.mjs && node scripts/idle-lane-test.mjs && node scripts/tentative-lane-test.mjs && node scripts/lane-work-test.mjs && node scripts/lane-sweep-test.mjs",
    "test:lanework": "node scripts/lane-work-test.mjs && node scripts/lane-sweep-test.mjs",
    "test:lanes:memory": "node scripts/lane-memory-test.mjs",
    "test:gate": "node scripts/release-gate-test.mjs",
    "test:grid": "node scripts/grid-layout-test.mjs",
    "test:buffer": "node scripts/outbuffer-test.mjs",
    "test:pump": "node scripts/pump-test.mjs",
    "test:remote": "node scripts/remote-test.mjs",
    "test:conflict": "node scripts/conflict-test.mjs",
    "test:rename": "node scripts/rename-repo-test.mjs",
    "test:rail": "node scripts/rail-test.mjs",
    "test:drag": "node scripts/drag-release-test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --win --dir",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "release": "electron-vite build && electron-builder --publish always",
    "try": "node scripts/try.mjs",
    "setup": "node scripts/setup.mjs",
    "ship": "node scripts/lane.mjs ship",
    "lane": "node scripts/lane.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.robert.paneforge",
    "productName": "PaneForge",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "robertiuoras",
        "repo": "PaneForge",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaneForge"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "PaneForge"
    }
  }
}
