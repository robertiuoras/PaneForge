{
  "name": "claude-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "PaneForge - desktop app to run and manage multiple Claude Code sessions",
  "author": "Robert",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "node scripts/smoke-pty.mjs",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --win --dir",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.robert.paneforge",
    "productName": "PaneForge",
    "files": ["out/**/*", "package.json"],
    "win": { "target": "dir" }
  }
}
