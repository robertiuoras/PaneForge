    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.robert.paneforge",
    "productName": "PaneForge",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/electron-liquid-glass/**"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "lane.mjs",
          "lane-hook.mjs",
          "lane-peers.mjs",
          "lane-merge.mjs",
          "test-app.mjs",
          "dev-profile.mjs",
          "release-notes.mjs",
          "pf-telegram.mjs"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "robertiuoras",
        "repo": "PaneForge",
        "releaseType": "prerelease"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaneForge",
      "include": "build/installer.nsh"
    },
    "afterPack": "scripts/mac-sign.mjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "PaneForge records what you dictate into a pane and types it at the agent's prompt. Nothing is recorded until you press the microphone.",
        "NSDesktopFolderUsageDescription": "PaneForge opens agents in your project folders. It only looks in the folder you chose as your projects root.",
        "NSDocumentsFolderUsageDescription": "PaneForge opens agents in your project folders. It only looks in the folder you chose as your projects root.",
        "NSDownloadsFolderUsageDescription": "PaneForge reads a folder here only when you pick one as a project.",
        "NSRemovableVolumesUsageDescription": "PaneForge reads a folder on an external disk only when you pick one as a project.",
        "NSLocalNetworkUsageDescription": "PaneForge finds your other computers running PaneForge on this network, so their panes can appear in this window. It never leaves your network.",
        "NSAppleEventsUsageDescription": "PaneForge does not script other apps; macOS asks for this when a pane's agent runs a command that does."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "PaneForge"
    }
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
